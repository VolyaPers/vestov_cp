{
  "name": "vestov-server",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "rm -rf dist && (tsc || true) && npm run copy-migrations",
    "copy-migrations": "cp -r drizzle dist/drizzle || true",
    "migrate": "node dist/migrate.js",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@clerk/backend": "^3.2.2",
    "@types/bcrypt": "^6.0.0",
    "@types/passport-google-oauth20": "^2.0.17",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "connect-pg-simple": "^9.0.1",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.45.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.17.3",
    "helmet": "^7.1.0",
    "multer": "^2.0.2",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-local": "^1.0.0",
    "pg": "^8.11.3",
    "socket.io": "^4.8.3",
    "stripe": "^20.3.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.17.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.9.0",
    "@types/passport": "^1.0.16",
    "@types/passport-google-oauth20": "^2.0.11",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.10.7",
    "tsx": "^4.6.0",
    "typescript": "^5.2.2"
  }
