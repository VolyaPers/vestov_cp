DATABASE_URL=postgresql://username:password@localhost:5432/vestov_portal
SESSION_SECRET=your-super-secret-session-key-change-in-production
NODE_ENV=development
PORT=3001
# CORS & Frontend
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173

# Slack Notifications
# Set to 'true' to enable Slack notifications
SLACK_NOTIFICATIONS_ENABLED=false

# Slack Bot Token (from Slack App settings)
# Get it from: https://api.slack.com/apps -> Your App -> OAuth & Permissions -> Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# Slack Channel IDs
# Get Channel ID: Open channel in Slack -> Click channel name -> View channel details -> Copy Channel ID
# Channel for shift notifications (start/end shifts, breaks)
SLACK_CHANNEL_ID=C1234567890

# Channel for admin notifications (reimbursements, vacation requests)
# Optional: If not set, will use SLACK_CHANNEL_ID
SLACK_ADMIN_CHANNEL_ID=C9876543210

# Email Configuration (optional)
INVITE_EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_URL=
RESEND_WEBHOOK_URL=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=Vestov Hub
SENDGRID_REPLY_TO_EMAIL=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Clerk (React + Vite)
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Cookie Domain (optional, for production)
COOKIE_DOMAIN=

# Force HTTPS (for production)
FORCE_HTTPS=false

# Payment Integrations (Stripe, Payoneer)
# Credentials are stored in the database via Admin > Finances UI
# No env vars needed — configure through the admin dashboard
