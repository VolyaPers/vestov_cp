{
  "name": "vestov-client-portal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/src/index.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc --project server/tsconfig.json",
    "preview": "vite preview",
    "start": "node server/dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/src/migrate.ts",
    "db:seed": "tsx server/src/seed.ts",
    "db:validate": "tsx server/src/scripts/validate-migrations.ts",
    "prebuild": "npm run db:validate",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:run:headless": "cypress run --headless",
    "test:e2e": "cypress run --spec \"cypress/e2e/invoice-creation.cy.ts\"",
    "test:e2e:open": "cypress open --e2e --spec \"cypress/e2e/invoice-creation.cy.ts\"",
    "test:total-calc": "cypress run --spec \"cypress/e2e/total-calculation-verification.cy.ts\"",
    "test:total-calc:open": "cypress open --e2e --spec \"cypress/e2e/total-calculation-verification.cy.ts\"",
    "test:pricing-fixes": "cypress run --spec \"cypress/e2e/invoice-pricing-fixes.cy.ts\"",
    "test:pricing-fixes:open": "cypress open --e2e --spec \"cypress/e2e/invoice-pricing-fixes.cy.ts\"",
    "test:navigation": "cypress run --spec \"cypress/e2e/admin-navigation.cy.ts\"",
    "test:navigation:open": "cypress open --e2e --spec \"cypress/e2e/admin-navigation.cy.ts\"",
    "test:page-load": "cypress run --spec \"cypress/e2e/simple-page-load-test.cy.ts\"",
    "test:page-load:open": "cypress open --e2e --spec \"cypress/e2e/simple-page-load-test.cy.ts\"",
    "test:team-crud": "cypress run --spec \"cypress/e2e/team-crud.cy.ts\"",
    "test:team-crud:open": "cypress open --e2e --spec \"cypress/e2e/team-crud.cy.ts\""
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.2",
    "@radix-ui/react-avatar": "^1.0.4",
    "@radix-ui/react-checkbox": "^1.0.4",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.0.4",
    "@tanstack/react-query": "^5.8.4",
    "@tanstack/react-query-devtools": "^5.8.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "drizzle-orm": "^0.30.10",
    "lucide-react": "^0.548.0",
    "react": "^18.2.0",
    "react-calendar": "^4.6.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.48.2",
    "recharts": "^3.2.0",
    "rsuite": "^5.83.3",
    "tailwind-merge": "^2.0.0",
    "tailwindcss-animate": "^1.0.7",
    "wouter": "^3.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.9.0",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "@vitejs/plugin-react": "^4.1.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "cypress": "^15.2.0",
    "drizzle-kit": "^0.31.8",
    "eslint": "^8.53.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.4",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.5",
    "tsx": "^4.20.5",
    "typescript": "^5.2.2",
    "vite": "^7.1.4"
  },
  "serverDependencies": {
    "bcryptjs": "^2.4.3",
    "connect-pg-simple": "^9.0.1",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.29.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.17.3",
    "helmet": "^7.1.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-local": "^1.0.0",
    "pg": "^8.11.3",
    "tsx": "^4.6.0"
  },
  "serverDevDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.17.10",
    "@types/passport": "^1.0.16",
    "@types/passport-google-oauth20": "^2.0.11",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.10.7"
  }
}
